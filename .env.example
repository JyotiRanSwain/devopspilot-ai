# Copy to .env and edit. Placeholders only: never commit real values.

# --- Web server ---
DOP_HOST=127.0.0.1
DOP_PORT=8000
# Required when DOP_HOST is not 127.0.0.1 (the app refuses to start without it). Use a long random value.
DOP_API_TOKEN=
DOP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Docker ---
# Leave empty to use the local Docker Desktop / socket. With Compose this points at the read-only socket proxy.
DOP_DOCKER_HOST=
DOP_LOG_MAX_LINES=1000

# --- AI (optional). Without it, rule-based diagnostics still work ---
# none | openai (any OpenAI-compatible endpoint) | bedrock (Amazon Bedrock Converse API)
DOP_AI_PROVIDER=none
DOP_AI_MODEL=
DOP_AI_BASE_URL=https://api.openai.com/v1
DOP_AI_API_KEY=
DOP_AI_TIMEOUT_SECONDS=30

# --- AWS (optional, read-only). Disabled until DOP_AWS_ENABLED=true ---
DOP_AWS_ENABLED=false
DOP_AWS_REGION=
# Named profile from ~/.aws/config (SSO or role). Do not put access keys in this file.
DOP_AWS_PROFILE=
