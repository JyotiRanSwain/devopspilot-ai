
# --- Web server ---
DOP_HOST=0.0.0.0
DOP_PORT=8000
DOP_API_TOKEN=REPLACE_WITH_YOUR_GENERATED_SECRET

# Replace with your actual EC2 public IPv4 address
DOP_ALLOWED_ORIGINS=http://3.90.103.248:8000

# --- Docker ---
DOP_DOCKER_HOST=tcp://docker-proxy:2375
DOP_LOG_MAX_LINES=1000

# --- AI: Ollama + lightweight Gemma 4 ---
DOP_AI_PROVIDER=openai
DOP_AI_MODEL=gemma4:e2b
DOP_AI_BASE_URL=http://ollama:11434/v1
DOP_AI_API_KEY=ollama
DOP_AI_TIMEOUT_SECONDS=120

# --- AWS integration ---
DOP_AWS_ENABLED=true
DOP_AWS_REGION=us-east-1
DOP_AWS_PROFILE=
